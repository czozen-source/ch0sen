rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WERSJA TESTOWA: rejestr wózków tylko dla konta czozen@gmail.com (isOwner()),
    // raport zmiany dla wszystkich zalogowanych.
    function signedIn() {
      return request.auth != null;
    }
    // Moderatorzy: dokument config/roles, pole "moderators" (tablica adresów e-mail, małymi literami).
    // Ten dokument zmienia się tylko w konsoli Firebase.
    // Właściciel: tylko to konto widzi rejestr wózków i usuwa raporty zmian.
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() == 'czozen@gmail.com';
    }
    // Budżet (docs/budzet.html): właściciel i konta poniżej, każde ze swoimi osobnymi danymi.
    // Konta tylko do budżetu nie widzą raportu zmiany, Redlinka, ustawień ani rejestru wózków.
    function isBudgetUser() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['czozen@gmail.com', 'annakurnik90@gmail.com'];
    }
    function isBudgetOnly() {
      return isBudgetUser() && !isOwner();
    }
    function isStaff() {
      return signedIn() && !isBudgetOnly();
    }
    function isMod() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/roles).data.moderators;
    }

    match /config/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Rejestr wózków (listy, rozpiska, zgłoszenia): wersja testowa – tylko właściciel.
    // Po testach: odczyt i rozpiska/zgłoszenia signedIn(), zmiana list isMod(), usuwanie zgłoszeń isMod().
    match /employees/{id} {
      allow read, write: if isOwner();
    }
    match /forklifts/{id} {
      allow read, write: if isOwner();
    }
    match /impacts/{id} {
      allow read, write: if isOwner();
    }
    // Ustawienia: settings/shiftReport należy do raportu zmiany (czytają wszyscy, zmienia moderator),
    // pozostałe dokumenty (mail, rozpiska) do rejestru wózków.
    match /settings/{id} {
      allow read: if (id == 'shiftReport' && isStaff()) || isOwner();
      allow write: if (id == 'shiftReport' && isMod()) || isOwner();
    }
    match /schedule/{day} {
      allow read, write: if isOwner();
    }
    // Raporty zmian i plan Redlink: wszyscy zalogowani; raport usuwa tylko właściciel.
    match /shift_reports/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isOwner();
    }
    match /redlink/{week} {
      allow read, write: if isStaff();
    }
    match /damages/{id} {
      allow read, write: if isOwner();
    }
    // Budżet Kokosza: tylko konta z isBudgetUser(), każde wyłącznie swój dokument (uid).
    match /budgets/{uid}/{document=**} {
      allow read, write: if isBudgetUser() && request.auth.uid == uid;
    }
  }
}
